{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PZMM",
  "identifier": "com.sevnc3.pzmm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "PZMM: Project Zomboid Mod Manager",
        "width": 1240,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Project Zomboid mod manager",
    "longDescription": "Install Project Zomboid mods from the Steam Workshop, GitHub or a zip, manage load order and switch between mod profiles.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}